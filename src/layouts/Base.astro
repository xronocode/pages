---
interface Props {
  title: string;
  // Full <title> override, used as-is (no site-name suffix).
  seoTitle?: string;
  description?: string;
  currentNav?: string;
  lang?: 'en' | 'ru';
  type?: 'website' | 'article';
  image?: string;
  date?: Date;
  tags?: string[];
  // hreflang alternates: { en: '/blog/x/', ru: '/blog/x-ru/' }
  alternates?: Partial<Record<'en' | 'ru', string>>;
}

import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE, COLLECT_KEY } from '../site';

const {
  title,
  seoTitle,
  description = SITE.description,
  currentNav = '',
  lang = 'en',
  type = 'website',
  image = SITE.ogImage,
  date,
  tags = [],
  alternates = {},
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const fullTitle = seoTitle ?? `${title} · ${SITE.name}`;
const hreflangs = Object.entries(alternates).filter(([, href]) => href);
const jsonld = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: imageUrl,
      datePublished: date?.toISOString(),
      inLanguage: lang,
      keywords: tags.join(', '),
      mainEntityOfPage: canonical,
      author: { '@type': 'Person', name: SITE.author, url: SITE.url, sameAs: SITE.sameAs },
      publisher: { '@type': 'Person', name: SITE.author },
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${SITE.url}/#website`,
          name: SITE.name,
          url: SITE.url,
          description: SITE.description,
          inLanguage: lang,
          author: { '@id': `${SITE.url}/#person` },
        },
        {
          '@type': 'Person',
          '@id': `${SITE.url}/#person`,
          name: SITE.author,
          url: SITE.url,
          jobTitle: SITE.jobTitle,
          knowsAbout: SITE.knowsAbout,
          sameAs: SITE.sameAs,
        },
      ],
    };
const navItems = [
  { id: 'home', label: 'home', href: '/' },
  { id: 'blog', label: 'essays', href: '/blog/' },
  { id: 'oss', label: 'oss', href: '/oss/' },
  { id: 'tools', label: 'ai tools', href: '/tools/' },
  { id: 'pets', label: 'pet projects', href: '/pets/' },
  { id: 'linkedin', label: 'linkedin', href: '/linkedin/' },
];
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  <link rel="canonical" href={canonical} />
  {hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href!, SITE.url).href} />)}
  {hreflangs.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en ?? Astro.url.pathname, SITE.url).href} />}

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
  {date && <meta property="article:published_time" content={date.toISOString()} />}
  {tags.map(t => <meta property="article:tag" content={t} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — essays`} href="/rss.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  {COLLECT_KEY && (
    // First-party page views: our own collector, no cookies and no third-party SDK.
    <script is:inline define:vars={{ collectKey: COLLECT_KEY }}>
      (function () {
        try {
          var sid = sessionStorage.getItem("wc_sid");
          if (!sid) {
            sid = Math.random().toString(36).slice(2) + Date.now().toString(36);
            sessionStorage.setItem("wc_sid", sid);
          }
          var id = "p" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
          fetch("https://dash.xronocode.com/api/v1/collect", {
            method: "POST",
            keepalive: true,
            headers: { "content-type": "application/json", "x-collect-key": collectKey },
            body: JSON.stringify({
              events: [{
                id: id,
                name: "pageview",
                session: sid,
                ts: Date.now(),
                path: location.pathname,
                referrer: document.referrer ? new URL(document.referrer).host : null
              }]
            })
          });
        } catch (e) {}
      })();
    </script>
  )}

  <link href="/fonts/fonts.css" rel="stylesheet">

</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-mark"><span>x</span></span>
      <span><span class="name">xronocode</span> <span class="dim">/ notebook</span></span>
    </a>
    <nav class="nav">
      {navItems.map(item => (
        <a href={item.href} aria-current={currentNav === item.id ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="topbar-end">
      <button class="icon-btn" id="palette-trigger" title="Search (⌘K)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>
      </button>
      <button class="icon-btn" id="theme-toggle" title="Toggle theme (⌘J)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div>
      <div class="col-title">xronocode</div>
      <div class="sig">Notes & discussions on shipping AI into banking, ecosystems, documents, and autonomous agents.</div>
      <div style="font-family: var(--mono); font-size: 11px; color: var(--ink-4); margin-top: 18px; letter-spacing: 0.04em;">
        © 2026 · Astro · cc-by-4.0
      </div>
    </div>
    <div>
      <div class="col-title">Sections</div>
      <ul>
        <li><a href="/blog/">Essays</a></li>
        <li><a href="/oss/">OSS</a></li>
        <li><a href="/tools/">AI Tools</a></li>
        <li><a href="/pets/">Pet projects</a></li>
      </ul>
    </div>
    <div>
      <div class="col-title">Elsewhere</div>
      <ul>
        <li><a href="https://github.com/xronocode" target="_blank" rel="noopener">GitHub ↗</a></li>
        <li><a href="https://linkedin.com/in/xronocode" target="_blank" rel="noopener">LinkedIn ↗</a></li>
        <li><a href="https://habr.com/ru/users/Xronofag/" target="_blank" rel="noopener">Habr ↗</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="#cookie-settings">Cookie settings</a></li>
      </ul>
    </div>
    <div>
      <div class="col-title">Languages</div>
      <ul>
        <li><a>EN — primary</a></li>
        <li><a>RU — mirror</a></li>
      </ul>
    </div>
  </footer>

  <CommandPalette />

  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.dataset.theme = 'dark';

      document.getElementById('theme-toggle').addEventListener('click', function() {
        var t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        localStorage.setItem('theme', t);
      });

      document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'j') {
          e.preventDefault();
          document.getElementById('theme-toggle').click();
        }
      });
    })();
  </script>
  <script is:inline>
    // GA4 events: what readers do beyond page_view. No-ops when the tag is off.
    (function() {
      function track(name, params) { if (typeof window.gtag === 'function') window.gtag('event', name, params || {}); }

      // Clicks into the projects / profiles this site exists to promote.
      document.addEventListener('click', function(e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var u; try { u = new URL(a.href, location.href); } catch (_) { return; }
        var host = u.hostname, label = (a.textContent || '').trim().slice(0, 60);
        if (/\.xronocode\.com$/.test(host) && host !== location.hostname) {
          track('project_click', { project: host.split('.')[0], link_text: label });
        } else if (host === 'github.com') {
          track('github_click', { path: u.pathname.split('/').slice(1, 3).join('/'), link_text: label });
        } else if (/habr\.com$|linkedin\.com$/.test(host)) {
          track('mirror_click', { network: host.replace(/^www\./, '').split('.')[0], link_text: label });
        }
      });

      // Article read-through: fire once when the reader reaches 75% of the prose.
      var prose = document.querySelector('article.prose');
      // A scroll check (not IntersectionObserver) so a fast jump past the marker still counts.
      var at = prose && prose.children[Math.floor(prose.children.length * 0.75)];
      if (at) {
        var onScroll = function() {
          if (at.getBoundingClientRect().top < window.innerHeight) {
            window.removeEventListener('scroll', onScroll);
            track('article_read', { article: location.pathname, lang: document.documentElement.lang });
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      var pal = document.getElementById('palette-trigger');
      if (pal) pal.addEventListener('click', function() { track('search_open'); });
    })();
  </script>
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "7ab583cef7484ab1a99acfc423833ac6"}'></script>
</body>
</html>
