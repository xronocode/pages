---
interface PaletteEntry {
  group: string;
  glyph: string;
  label: string;
  hint: string;
  href: string;
}

interface Props {
  entries?: PaletteEntry[];
}

const defaultEntries: PaletteEntry[] = [
  { group: 'Go', glyph: '→', label: 'Home', hint: 'G H', href: '/' },
  { group: 'Go', glyph: '→', label: 'Essays', hint: 'G E', href: '/blog/' },
  { group: 'Go', glyph: '→', label: 'OSS contributions', hint: 'G O', href: '/oss/' },
  { group: 'Go', glyph: '→', label: 'AI Tools', hint: 'G A', href: '/tools/' },
  { group: 'Go', glyph: '→', label: 'Pet projects', hint: 'G P', href: '/pets/' },
  { group: 'Go', glyph: '→', label: 'LinkedIn', hint: 'G L', href: '/linkedin/' },
];

import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const postEntries: PaletteEntry[] = posts.map(p => ({
  group: 'Essays',
  glyph: '§',
  label: p.data.title,
  hint: p.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
  href: `/blog/${p.id}/`,
}));

const allEntries = [...defaultEntries, ...postEntries];
---

<div id="cmd-palette-overlay" class="palette-overlay" style="display:none;" data-entries={JSON.stringify(allEntries)}>
  <div class="palette" id="cmd-palette">
    <input type="text" id="cmd-input" placeholder="search essays, sections, actions…" autocomplete="off" />
    <div class="palette-list" id="cmd-list"></div>
    <div class="palette-foot">
      <span>↑↓ navigate · ↵ open · esc close</span>
      <span>⌘K everywhere</span>
    </div>
  </div>
</div>

<style is:global>
  .palette-overlay {
    position: fixed; inset: 0;
    background: color-mix(in oklch, var(--ink) 60%, transparent);
    backdrop-filter: blur(6px);
    z-index: 100;
    display: grid;
    place-items: start center;
    padding-top: 14vh;
    animation: fadeIn 0.15s ease;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .palette {
    width: min(640px, 92vw);
    background: var(--paper);
    border: 1px solid var(--rule);
    box-shadow: 0 30px 80px -20px color-mix(in oklch, var(--ink) 40%, transparent);
    display: flex; flex-direction: column;
    max-height: 70vh;
  }
  .palette input {
    font-family: var(--serif);
    font-size: 22px;
    padding: 22px 24px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    outline: none;
    font-style: italic;
  }
  .palette input::placeholder { color: var(--ink-4); }
  .palette-list { overflow-y: auto; padding: 8px 0; }
  .palette-group {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-4);
    padding: 10px 24px 6px;
  }
  .palette-item {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 10px 24px;
    font-size: 14px;
    cursor: pointer;
    color: var(--ink);
    text-decoration: none;
  }
  .palette-item:hover, .palette-item.active {
    background: var(--paper-2);
    color: var(--accent);
  }
  .palette-item .glyph {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
    text-align: center;
  }
  .palette-item .hint {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-4);
    letter-spacing: 0.04em;
  }
  .palette-foot {
    border-top: 1px solid var(--rule);
    padding: 10px 24px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-4);
    display: flex; justify-content: space-between;
    letter-spacing: 0.04em;
  }
  .palette-empty {
    padding: 32px;
    text-align: center;
    color: var(--ink-4);
    font-family: var(--mono);
    font-size: 12px;
  }
</style>

<script is:inline>
(function() {
  var overlay = document.getElementById('cmd-palette-overlay');
  var input = document.getElementById('cmd-input');
  var list = document.getElementById('cmd-list');
  var entries = JSON.parse(overlay.dataset.entries);
  var active = 0;
  var flat = [];

  function render(q) {
    var needle = (q || '').toLowerCase();
    var groups = {};
    entries.forEach(function(e) {
      if (needle && e.label.toLowerCase().indexOf(needle) === -1) return;
      if (!groups[e.group]) groups[e.group] = [];
      groups[e.group].push(e);
    });

    flat = [];
    var html = '';
    var keys = Object.keys(groups);
    if (keys.length === 0) {
      html = '<div class="palette-empty">no matches</div>';
    } else {
      keys.forEach(function(g) {
        html += '<div class="palette-group">' + g + '</div>';
        groups[g].forEach(function(e) {
          var idx = flat.length;
          flat.push(e);
          html += '<a class="palette-item' + (idx === active ? ' active' : '') + '" href="' + e.href + '" data-idx="' + idx + '">'
            + '<span class="glyph">' + e.glyph + '</span>'
            + '<span>' + e.label + '</span>'
            + '<span class="hint">' + e.hint + '</span>'
            + '</a>';
        });
      });
    }
    list.innerHTML = html;
  }

  function open() {
    overlay.style.display = 'grid';
    input.value = '';
    active = 0;
    render('');
    setTimeout(function() { input.focus(); }, 30);
  }

  function close() {
    overlay.style.display = 'none';
  }

  function go() {
    if (flat[active]) {
      window.location.href = flat[active].href;
      close();
    }
  }

  function setActive(i) {
    active = Math.max(0, Math.min(flat.length - 1, i));
    var items = list.querySelectorAll('.palette-item');
    items.forEach(function(el, idx) {
      el.classList.toggle('active', idx === active);
    });
    if (items[active]) items[active].scrollIntoView({ block: 'nearest' });
  }

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) close();
  });

  input.addEventListener('input', function() {
    active = 0;
    render(input.value);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { close(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); go(); }
  });

  list.addEventListener('mouseover', function(e) {
    var item = e.target.closest('.palette-item');
    if (item) setActive(parseInt(item.dataset.idx));
  });

  document.addEventListener('keydown', function(e) {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (overlay.style.display === 'none') open(); else close();
    }
  });

  var trigger = document.getElementById('palette-trigger');
  if (trigger) {
    trigger.addEventListener('click', function() {
      if (overlay.style.display === 'none') open(); else close();
    });
  }
})();
</script>
