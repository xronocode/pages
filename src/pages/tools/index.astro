---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');
---

<Base title="AI Tools" currentNav="tools">
  <div class="page-fade site-frame">
    <div class="hero" style="padding: var(--row) 0;">
      <div class="label"><div class="eyebrow">workshop · {tools.length.toString().padStart(2, '0')} tools</div></div>
      <div>
        <h1>Open tools for <em>agent-shaped</em> work.</h1>
      </div>
    </div>
    <div class="card-grid cols-3">
      {tools.map((t) => {
        const href = t.data.url;
        const content = (
          <>
            <div class="glyph">{t.data.glyph}</div>
            <h4>{t.data.title}</h4>
            <p>{t.data.description}</p>
            <div class="tags">{t.data.tags.map(x => <span>#{x}</span>)}</div>
            {href && <div class="corner">open →</div>}
          </>
        );

        return href ? (
          <a href={href} class="card" style="text-decoration: none; color: inherit;">
            {content}
          </a>
        ) : (
          <div class="card">
            {content}
          </div>
        );
      })}
    </div>

    <div class="fineprint">
      Pull requests welcome. Each tool's repo carries a CLAUDE.md describing how to extend it without breaking the contract.
    </div>
  </div>
</Base>
