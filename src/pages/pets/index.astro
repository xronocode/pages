---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const pets = await getCollection('pets');

const stars: Record<string, number> = {};
await Promise.all(pets.map(async (p) => {
  if (!p.data.url?.includes('github.com')) return;
  const repo = p.data.url.replace('https://github.com/', '').replace(/\.git$/, '');
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: { 'Accept': 'application/vnd.github+json' },
    });
    if (res.ok) {
      const json = await res.json();
      stars[p.id] = json.stargazers_count ?? 0;
    }
  } catch {}
}));
---

<Base title="Pet Projects" currentNav="pets">
  <div class="page-fade site-frame">
    <div class="hero" style="padding: var(--row) 0;">
      <div class="label"><div class="eyebrow">side · {pets.length.toString().padStart(2, '0')} shipped</div></div>
      <div>
        <h1>Pet projects — <em>shipped</em>, not just started.</h1>
      </div>
    </div>
    <div class="card-grid">
      {pets.map(p => (
        <a href={p.data.url} class="card" style="min-height: 280px; text-decoration: none; color: inherit;" target="_blank" rel="noopener">
          <div class="glyph">{p.data.glyph}</div>
          <h4>{p.data.title}</h4>
          <p>{p.data.description}</p>
          <div class="tags">{p.data.tags.map(x => <span>#{x}</span>)}</div>
          <div class="corner">
            {stars[p.id] > 0 && <span>{stars[p.id]}&#9733;&ensp;</span>}
            {p.data.version}
          </div>
        </a>
      ))}
      <div class="card" style="min-height: 280px; opacity: 0.55;">
        <div class="glyph" style="color: var(--ink-3);">—</div>
        <h4 style="color: var(--ink-3);">In slow cooker</h4>
        <p>A static-site bilingual reading tracker — front-end finished, sync layer still under thought.</p>
        <div class="tags"><span>#wip</span></div>
        <div class="corner">eta Q3</div>
      </div>
    </div>
  </div>
</Base>
